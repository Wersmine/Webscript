RageTab:CreateSection("ESP")
local espBox, espName, espHealth, espTracer = false, false, false, false
local espBoxSize = 3
local espObjects, tracerLines = {}, {}

local function clearESP(plr)
    if espObjects[plr] then
        for _, obj in pairs(espObjects[plr]) do if obj then obj:Destroy() end end
        espObjects[plr] = nil
    end
    if tracerLines[plr] then
        pcall(function() tracerLines[plr]:Remove() end)
        tracerLines[plr] = nil
    end
end

local function createESP(plr)
    clearESP(plr)
    espObjects[plr] = {}
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if espBox then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "ESP_Box"; box.Size = Vector3.new(espBoxSize, espBoxSize*1.8, espBoxSize)
        box.Adornee = hrp; box.AlwaysOnTop = true; box.ZIndex = 5
        box.Transparency = 0.5; box.Color3 = Color3.fromRGB(255,0,0); box.Parent = hrp
        table.insert(espObjects[plr], box)
    end
    if espName then
        local bg = Instance.new("BillboardGui")
        bg.Name = "ESP_Name"; bg.Size = UDim2.new(0,100,0,20)
        bg.StudsOffset = Vector3.new(0,3,0); bg.AlwaysOnTop = true; bg.Adornee = hrp; bg.Parent = hrp
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1
        txt.Text = plr.Name; txt.TextColor3 = Color3.fromRGB(255,255,255)
        txt.TextStrokeTransparency = 0; txt.Font = Enum.Font.SourceSansBold
        txt.TextSize = 14; txt.Parent = bg
        table.insert(espObjects[plr], bg)
    end
    if espHealth then
        local bg = Instance.new("BillboardGui")
        bg.Name = "ESP_Health"; bg.Size = UDim2.new(0,100,0,10)
        bg.StudsOffset = Vector3.new(0,2.4,0); bg.AlwaysOnTop = true; bg.Adornee = hrp; bg.Parent = hrp
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1,0,1,0); bar.BackgroundColor3 = Color3.fromRGB(0,255,0)
        bar.BorderSizePixel = 0; bar.Parent = bg
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local function updateBar() bar.Size = UDim2.new(humanoid.Health/humanoid.MaxHealth,0,1,0) end
            humanoid.HealthChanged:Connect(updateBar); updateBar()
        end
        table.insert(espObjects[plr], bg)
    end
end

