-- ============================================
-- ЛОГИКА (Полёт с паузой + FPS)
-- ============================================
RunService.RenderStepped:Connect(function(dt)
    if not flyEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not flyLinear or not flyLinear.Parent then
        createFlyVelocity(hrp)
    end

    -- Логика паузы для прогрузки карты
    if not isPaused then
        flyTimeCounter = flyTimeCounter + dt
        if flyTimeCounter >= 10 then
            isPaused = true
            flyTimeCounter = 0
            StatusText.Text = "Статус: ПАУЗА (Прогрузка...)"
            flyLinear.VectorVelocity = Vector3.new(0, 0, 0) -- Стоп
            task.delay(2, function()
                if flyEnabled then
                    isPaused = false
                    StatusText.Text = "Статус: Летим..."
                end
            end)
        end
    end

    if not isPaused then
        -- Летим вперед по X
        flyLinear.VectorVelocity = Vector3.new(flySpeed, 0, 0)
    end
    
    -- Держим высоту
    hrp.CFrame = CFrame.new(hrp.Position.X, roadY, roadZ)
end)

