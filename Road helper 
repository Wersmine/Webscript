local flyLinear, flyAttachment

local function createFlyVelocity(hrp)
    if flyLinear and flyLinear.Parent then return end
    flyAttachment = Instance.new("Attachment", hrp)
    flyLinear = Instance.new("LinearVelocity", hrp)
    flyLinear.Attachment0 = flyAttachment
    flyLinear.MaxForce = math.huge
    flyLinear.VectorVelocity = Vector3.new(0, 0, 0)
    flyLinear.RelativeTo = Enum.ActuatorRelativeTo.World
end

FlyBtn.MouseButton1Click:Connect(function()
    flyEnabled = not flyEnabled
    if flyEnabled then
        FlyBtn.Text = "🛑 ОСТАНОВИТЬ ПОЛЁТ"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        StatusText.Text = "Статус: Летим..."
        flyTimeCounter = 0
        isPaused = false
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(roadX, roadY, roadZ)
                createFlyVelocity(hrp)
            end
        end
    else
        FlyBtn.Text = "▶ ВКЛЮЧИТЬ АВТО-ПОЛЁТ"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        StatusText.Text = "Статус: Остановлено"
        if flyLinear then flyLinear:Destroy() flyLinear = nil end
        if flyAttachment then flyAttachment:Destroy() flyAttachment = nil end
    end
end)

