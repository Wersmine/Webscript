local flyLinear, flyAttachment

local function createFlyVelocity(hrp)
    if flyLinear and flyLinear.Parent then return end
    flyAttachment = Instance.new("Attachment", hrp)
    flyLinear = Instance.new("LinearVelocity", hrp)
    flyLinear.Attachment0 = flyAttachment
    flyLinear.MaxForce = math.huge
    flyLinear.VectorVelocity = Vector3.new(0, 0, 0)
    flyLinear.RelativeTo = Enum.ActuatorRelativeTo.World
end

FlyBtn.MouseButton1Click:Connect(function()
    flyEnabled = not flyEnabled
    if flyEnabled then
        FlyBtn.Text = "🛑 ОСТАНОВИТЬ ПОЛЁТ"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        isPaused = false
        flyTimeCounter = 0
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then createFlyVelocity(hrp) end
        end
    else
        FlyBtn.Text = "▶ ВКЛЮЧИТЬ ПОЛЁТ (По камере)"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        if flyLinear then flyLinear:Destroy() flyLinear = nil end
        if flyAttachment then flyAttachment:Destroy() flyAttachment = nil end
    end
end)

-- Полёт + Пауза
RunService.RenderStepped:Connect(function(dt)
    if not flyEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local cam = workspace.CurrentCamera
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not flyLinear or not flyLinear.Parent then createFlyVelocity(hrp) end

    -- Логика паузы для прогрузки карты
    if not isPaused then
        flyTimeCounter = flyTimeCounter + dt
        if flyTimeCounter >= 10 then
            isPaused = true
            flyTimeCounter = 0
            flyLinear.VectorVelocity = Vector3.new(0, 0, 0)
            task.delay(2, function() if flyEnabled then isPaused = false end end)
        end
    end

    if not isPaused then
        local camLook = cam.CFrame.LookVector
        flyLinear.VectorVelocity = camLook * flySpeed
    end
end)

-- God Mode (Блокировка урона + Атрибуты)
local function applyGodMode(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if not hum:GetAttribute("GodModeHooked") then
        local oldTakeDamage = hum.TakeDamage
        hum.TakeDamage = function(self, amount) if godModeEnabled then return end return oldTakeDamage(self, amount) end
        hum:SetAttribute("GodModeHooked", true)
    end
end

LocalPlayer.CharacterAdded:Connect(function(char) task.wait(1); applyGodMode(char) end)

RunService.Heartbeat:Connect(function()
    if not godModeEnabled then return end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
    end
    pcall(function()
        LocalPlayer:SetAttribute("Hunger", 100)
        LocalPlayer:SetAttribute("Thirst", 100)
        LocalPlayer:SetAttribute("Energy", 100)
    end)
end)

-- Триггер
local function checkCrosshair()
    local cam = workspace.CurrentCamera
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
    local result = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * triggerRange, rayParams)
    if result and result.Instance then
        local parentModel = result.Instance:FindFirstAncestorOfClass("Model")
        if parentModel then
            local hum = parentModel:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(parentModel) then return true end
        end
    end
    return false
end

RunService.RenderStepped:Connect(function(dt)
    if not triggerEnabled then return end
    triggerCooldown = triggerCooldown - dt
    if triggerCooldown > 0 then return end
    if checkCrosshair() then
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildWhichIsA("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end
        triggerCooldown = triggerDelay
    end
end)

-- Аимбот (камера)
RunService:BindToRenderStep("AimbotCamera", Enum.RenderPriority.Camera.Value + 1, function()
    if not aimEnabled then return end
    local cam = workspace.CurrentCamera
    local closest, dist = nil, 300
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local sp, on = cam:WorldToViewportPoint(head.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < dist then dist = d; closest = head end
                end
            end
        end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local part = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
                if part then
                    local sp, on = cam:WorldToViewportPoint(part.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < dist then dist = d; closest = part end
                    end
                end
            end
        end
    end

    if closest then
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, closest.Position), 0.2)
    end
end)

